{
  "mcpServers": {
    "github-mcp": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "openspec-filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}/openspec"
      ]
    },
    "azure-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    }
  }
}